# Copy to .env for local development. NEVER commit .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace_with_a_secure_random_key_at_least_32_chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Connection URL (PostgreSQL only)
DATABASE_URL=postgresql://user:password@localhost:5432/dealerdesk

# Supplier Mock Service (Optional, for supplier sync)
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=dev-supplier-key

# Optional LLM Provider Configuration (set only the provider you use)
# LLM_PROVIDER can be 'gemini', 'groq', or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq alternative:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI alternative:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Distributor Account Initialization (used by create_distributor management command)
DISTRIBUTOR_USERNAME=distributor
DISTRIBUTOR_PASSWORD=your_secure_distributor_password_here
DISTRIBUTOR_EMAIL=distributor@example.com

